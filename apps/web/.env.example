# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=life_notes

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL if the bucket is served via a custom domain / R2.dev public access
R2_PUBLIC_BASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe (fase de eventos/coaching)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Instagram Graph API (cinta de últimas publicaciones en Sobre Pilar)
# Requiere una cuenta de Instagram profesional (Business/Creator) vinculada
# a una app de Meta. INSTAGRAM_ACCESS_TOKEN es un token de larga duración
# (~60 días) generado desde Graph API Explorer o el flujo OAuth de Meta;
# hay que regenerarlo antes de que expire. INSTAGRAM_USER_ID es el ID de
# la cuenta de Instagram Business (no el @usuario).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
